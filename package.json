{
  "name": "power-zone-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Phone-friendly power zone training plans and ride timer for an indoor bike.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run test && npm run format:check"
  },
  "dependencies": {
    "solid-js": "^1.9.20"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.17",
    "vitest": "^5.1.2"
  }
}
